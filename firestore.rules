rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✏️ Replace with YOUR admin email(s). Keep in sync with VITE_ADMIN_EMAILS.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@yourdomain.com'];
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Invoices contain customer details — admin only.
    match /invoices/{id} {
      allow read, write: if isAdmin();
    }

    // Orders are created and marked paid ONLY by the server (Firebase Admin SDK bypasses these rules).
    // Customers can read their own; the admin can read all and update the fulfilment status.
    match /orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fulfilment']);
      allow create, delete: if false;
    }

    match /users/{uid} {
      // Saved addresses: owner only.
      match /addresses/{addressId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['name', 'phone', 'line1', 'line2', 'city', 'state', 'pincode', 'isDefault', 'createdAt'])
          && request.resource.data.line1 is string && request.resource.data.line1.size() <= 200;
      }
      // Proof of purchase, written by the payment API. Read-only for the customer.
      match /purchases/{productId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
    }

    // One review per customer per product (id = productId_uid), only after a verified purchase.
    match /reviews/{reviewId} {
      function validReview() {
        let r = request.resource.data;
        return r.keys().hasOnly(['productId', 'uid', 'name', 'photo', 'rating', 'text', 'createdAt'])
          && r.uid == request.auth.uid
          && reviewId == r.productId + '_' + request.auth.uid
          && r.rating is int && r.rating >= 1 && r.rating <= 5
          && r.text is string && r.text.size() >= 3 && r.text.size() <= 1000
          && r.name is string && r.name.size() <= 60
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/purchases/$(r.productId));
      }
      allow read: if true;
      allow create: if request.auth != null && validReview();
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && validReview()
        && request.resource.data.productId == resource.data.productId;
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
  }
}
