# ───────────── Browser (VITE_*) — bundled into the site, never put secrets here ─────────────
# Firebase (Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (Settings > Upload > Upload presets > add UNSIGNED preset)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# WhatsApp number with country code, digits only (e.g. 919876543210)
VITE_WHATSAPP_NUMBER=
# Optional: your Instagram handle
VITE_INSTAGRAM=

# Comma-separated admin emails allowed into /admin (must match firestore.rules)
VITE_ADMIN_EMAILS=admin@yourdomain.com

# Cashfree checkout mode: sandbox | production
VITE_CASHFREE_MODE=sandbox

# ───────────── Server only (Vercel functions in /api) — SECRET, set in Vercel dashboard ─────────────
# Cashfree (Dashboard > Developers > API keys). Use TEST keys with CASHFREE_ENV=sandbox.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Firebase Admin (Project settings > Service accounts > Generate new private key)
# Either paste the whole JSON on one line…
FIREBASE_SERVICE_ACCOUNT=
# …or use the three fields below (keep the \n sequences in the private key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public site URL used for Cashfree return/webhook URLs (e.g. https://theexcessorystudio.com).
# Optional on Vercel — falls back to the request host.
SITE_URL=
